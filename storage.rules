rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /lot_photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /plate_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}

